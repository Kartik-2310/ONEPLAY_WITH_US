rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is an admin
    // Assumes custom claims { "admin": true } or a special admin list inside Firestore
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Check if the user is accessing their own data
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users Collection - users can read/write their own profiles, admins can do all
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Wallets Collection - Node.js manages balances.
    // Users can only update their upiId.
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upiId']);
      allow create, delete: if false; 
    }

    // Transactions - log of all deposits, withdrawals, winnings
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // ❌ STRICTLY DENY WRITES FROM CLIENT. Backend handles ledger.
    }

    // Withdrawal Requests - users can read their own, admins can read all
    match /withdrawRequests/{withdrawalId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // ❌ Backend handles withdrawals via /api/withdraw
    }

    // Legacy support for withdrawals endpoint
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false; // ❌ Backend handles this via POST /withdraw
    }
    
    // Legacy support for bindings in older app
    match /winnings/{winningId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /deposits/{depositId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Tournaments - Everyone can read, only admin can create/edit/delete
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
      
      // Joined Users Subcollection
      match /joinedUsers/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && isOwner(userId) || isAdmin();
      }
      
      match /winners/{winnerId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // Notifications / Analytics
    match /notifications/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /analytics/{docId} {
        allow read, write: if isAdmin();
    }
  }
}
